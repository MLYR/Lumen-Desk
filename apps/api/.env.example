# Copy to .env (never commit .env). All values below are examples.
PORT=3000
# SQLite file (lumen.db) and bookmarks.json live here. Gitignored (data/).
DATA_DIR=./data
# Base32 secret printed by `pnpm --filter api init-totp`.
TOTP_SECRET=
TOTP_ISSUER=Lumen Desk
TOTP_LABEL=zreo
# Must be true in production (HTTPS). Set false only for local http dev.
COOKIE_SECURE=true
# true: client IP = first X-Forwarded-For hop (set by Caddy). false: socket address.
TRUST_PROXY=true
# Used in the User-Agent sent to AIHOT: lumen-desk/1.0 (+SITE_URL)
SITE_URL=https://example.com
# Directory with blog.html (the blog page shell built by apps/web). Default: ../web/dist-shell.
# Uploaded images go to DATA_DIR/uploads (not configurable).
SHELL_DIR=../web/dist-shell
# Read-only host files for the console server card: os-release, hostname, net_dev (= host /proc/1/net/dev).
# Missing files degrade gracefully (container's own OS name, no network row). Default: /host.
HOST_ROOT=/host
# 定时全量备份（每天 03:35 在 api 进程里跑）。默认写到 DATA_DIR/backups，保留 14 份。
# 备份里不含验证器密钥、恢复码和会话；恢复用 `node dist/cli/backup.js restore <文件> --yes`。
BACKUP_DIR=
BACKUP_KEEP=14
# 32-byte key, base64, for AES-256-GCM encryption of the TOTP secret stored in the database.
# Generate: openssl rand -base64 32   (never commit it). Unset = stored unencrypted, with a warning.
SECRET_KEY=
