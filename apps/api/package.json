{
  "name": "api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "init-totp": "tsx --env-file-if-exists=.env src/cli/init-totp.ts",
    "revoke-sessions": "tsx --env-file-if-exists=.env src/cli/revoke-sessions.ts",
    "import-bookmarks": "tsx --env-file-if-exists=.env src/cli/import-bookmarks.ts",
    "unlock-logins": "tsx --env-file-if-exists=.env src/cli/unlock-logins.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "croner": "^11.0.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "markdown-it": "^15.0.3",
    "otpauth": "^9.5.2",
    "qrcode-terminal": "^0.12.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
