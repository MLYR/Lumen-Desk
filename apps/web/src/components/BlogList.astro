---
import "../styles/blog.css";
---
<section class="grid" id="blog">
  <article class="card first last">
    <div class="card-head">
      <h2 class="card-title"><span class="dot"></span>博客</h2>
      <span class="card-meta"><a href="/blog/">全部文章</a> · <a href="/rss.xml">RSS</a></span>
    </div>
    <ul class="post-list" id="home-posts" aria-live="polite">
      <li class="empty">加载中…</li>
    </ul>
  </article>
</section>

<script>
  // 运行时取最新 3 篇。失败时安静地显示空态；所有外部文本都转义，链接只指向 /blog/<slug>/。
  type Item = { slug: string; title: string; summary?: string; tags?: string[]; publishedAt?: string | null; category?: { slug: string; name: string } | null };
  const esc = (s: unknown) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string));
  const day = (iso?: string | null) => {
    const d = iso ? new Date(iso) : null;
    if (!d || isNaN(d.getTime())) return "";
    const p = (n: number) => String(n).padStart(2, "0");
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
  };
  const box = document.getElementById("home-posts")!;
  const empty = () => { box.innerHTML = `<li class="empty">还没有文章</li>`; };
  (async () => {
    try {
      const res = await fetch("/api/posts?limit=3");
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      const items: Item[] = (Array.isArray(data.items) ? data.items : []).filter((x: Item) => x && typeof x.slug === "string" && /^[a-z0-9-]{1,80}$/.test(x.slug) && typeof x.title === "string").slice(0, 3);
      if (!items.length) return empty();
      box.innerHTML = items.map((x) =>
        `<li><a href="/blog/${esc(x.slug)}/"><span class="d">${esc(day(x.publishedAt))}</span>` +
        `<div><div class="t">${esc(x.title)}</div>${x.summary ? `<div class="s">${esc(x.summary)}</div>` : ""}</div>` +
        `<span class="tags">${x.category && typeof x.category.name === "string" ? `<span class="cat">${esc(x.category.name)}</span>` : ""}${esc((Array.isArray(x.tags) ? x.tags : []).join(" · "))}</span></a></li>`).join("");
    } catch { empty(); }
  })();
</script>
