---
interface Props { wide?: boolean; }
const { wide = false } = Astro.props;
---
<footer>
  <div class:list={["wrap", { "wrap-blog": wide }]}>
    <span class="legal">
      © 2026 zreo ·
      <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">陕ICP备2026034153号-1</a>
      {/* 公安联网备案下来后在这行补一个 <a>：陕公网安备XXXXXXXX号，链到 beian.mps.gov.cn 的查询页 */}
    </span>
    <a class="login-link" href="/console" title="控制台登录">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="5" y="11" width="14" height="10"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>控制台</a>
  </div>
</footer>

<style is:global>
.login-link { display: inline-flex; align-items: center; gap: 6px; }
.legal a { color: inherit; text-decoration: none; }
.legal a:hover { text-decoration: underline; }
</style>
