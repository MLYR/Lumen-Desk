---
import ThemeSwitch from "./ThemeSwitch.astro";
interface Props { current?: "home" | "blog"; }
const { current = "home" } = Astro.props;
---
<header class="top">
  <div class="wrap">
    <a class="brand" href="/"><span class="brand-mark">z</span>zreo</a>
    <nav class="nav" aria-label="主导航">
      <a href="/" aria-current={current === "home" ? "page" : undefined}>主页</a>
      <a href="/#resume">简历</a>
      <a href="/blog/" aria-current={current === "blog" ? "page" : undefined}>博客</a>
      <a href="/#lab">试验场</a>
    </nav>
    <div class="top-right">
      <ThemeSwitch />
    </div>
  </div>
</header>
