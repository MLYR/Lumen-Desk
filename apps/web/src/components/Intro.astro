---
import "../styles/intro.css";
---
<section class="intro" id="intro">
  <div>
    <div class="coord">// HELLO WORLD</div>
    <h1>写代码，<br>也喜欢研究<em>新东西</em>。</h1>
    <p id="intro-tagline">我是 zreo，一名程序员。这里放我的简历、技术笔记，以及一些用 Canvas、WebGPU、WASM 做的小实验。（文案待你确认）</p>
    <div class="cta" id="intro-cta">
      <a class="primary" href="#resume">看简历</a>
      <a href="/blog/">读博客</a>
      <a class="extra" href="https://github.com" target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>
  <dl class="intro-side" id="intro-side">
    <div><dt>职业</dt><dd>程序员</dd></div>
    <div><dt>坐标</dt><dd>上海</dd></div>
    <div><dt>在研究</dt><dd>Astro · Hono · AI Agent</dd></div>
    <div><dt>联系</dt><dd>待填写</dd></div>
  </dl>
</section>

<script>
  // 运行时读取个人资料替换简介；请求失败时保留上面构建时写好的文案。h1 大标题不变。
  import { renderIntro, type PublicProfile } from "../scripts/intro-render";
  (async () => {
    try {
      const res = await fetch("/api/profile");
      if (!res.ok) return;
      const p = (await res.json()) as PublicProfile;
      if (!p || typeof p.name !== "string") return;
      renderIntro(p, {
        tagline: document.getElementById("intro-tagline")!,
        side: document.getElementById("intro-side")!,
        cta: document.getElementById("intro-cta")!,
      });
      // 顶栏的名字和首字母
      const brand = document.querySelector<HTMLElement>(".top .brand");
      const mark = brand?.querySelector<HTMLElement>(".brand-mark");
      if (brand && mark && p.name.trim()) {
        mark.textContent = [...p.name.trim()][0].toLowerCase();
        brand.replaceChildren(mark, document.createTextNode(p.name.trim()));
      }
    } catch { /* 保留静态文案 */ }
  })();
</script>
