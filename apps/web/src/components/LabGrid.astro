---
import type { LabItem } from "../lib/lab";

interface Props {
  items: LabItem[];
}

const { items } = Astro.props;
const featured = items.find((item) => item.featured) ?? items[0];
const rest = items.filter((item) => item !== featured);
---
{featured ? (
  <div class="labs">
    <a class="lab lab-feature" href={featured.href}>
      <div class="pv feature-pv">
        {featured.cover ? (
          <img
            src={featured.cover}
            alt={featured.coverAlt ?? featured.name}
            width="1440"
            height="720"
            loading="lazy"
            decoding="async"
          />
        ) : null}
      </div>
      <div class="body">
        <div class="kicker">{featured.kicker}</div>
        <div class="nm">{featured.name}</div>
        <div class="ds">{featured.summary}</div>
        <div class="st"><span>{featured.status}</span><span class="go">进入实验 →</span></div>
      </div>
    </a>
    {rest.map((item) => (
      <a class="lab lab-small" href={item.href}>
        {item.cover ? (
          <div class="pv">
            <img
              src={item.cover}
              alt={item.coverAlt ?? item.name}
              width="1440"
              height="720"
              loading="lazy"
              decoding="async"
            />
          </div>
        ) : null}
        <div class="body">
          <div class="kicker">{item.kicker}</div>
          <div class="nm">{item.name}</div>
          <div class="ds">{item.summary}</div>
          <div class="st"><span>{item.status}</span><span class="go">进入 →</span></div>
        </div>
      </a>
    ))}
  </div>
) : (
  <p class="lab-empty">还没有实验。做出来再放上来。</p>
)}

<style is:global>
.labs { display: grid; gap: 16px; grid-template-columns: 1fr; }
@media (min-width: 600px) { .labs { grid-template-columns: 1fr 1fr; } }
@media (min-width: 900px) { .labs { grid-template-columns: repeat(3, 1fr); } }
.lab { display: block; border: 1px solid var(--soft-line); min-width: 0; }
a.lab:hover { border-color: var(--accent); }
.lab .pv { height: 160px; display: block; width: 100%; border-bottom: 1px solid var(--soft-line); }
.lab .pv img { display: block; width: 100%; height: 100%; object-fit: cover; }
.lab-small { display: flex; flex-direction: column; }
.lab-small .pv { height: 170px; border-bottom: 1px solid var(--soft-line); overflow: hidden; }
.lab-small .body { padding: 20px; display: flex; flex-direction: column; flex: 1; }
.lab-small .kicker { font-family: var(--mono); font-size: 10px; letter-spacing: .18em; color: var(--muted); margin-bottom: 8px; }
.lab-small .nm { font-size: 20px; font-weight: 700; margin-bottom: 8px; }
[data-theme="blueprint"] .lab-small .nm { font-family: var(--mono); font-weight: 500; }
.lab-small .ds { font-size: 13px; line-height: 1.65; }
.lab-small .st { display: flex; justify-content: space-between; gap: 12px; padding-top: 14px; margin-top: auto; border-top: 1px solid var(--soft-line); font-family: var(--mono); font-size: 11px; color: var(--muted); }
.lab-small .go { color: var(--fg); }
a.lab-small:hover .go { color: var(--accent); }
.lab-empty { font-size: 13px; color: var(--muted); }
.lab-feature { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(260px, .85fr); }
.lab-feature .pv { height: 100%; min-height: 290px; border-bottom: 0; border-right: 1px solid var(--soft-line); overflow: hidden; }
.lab-feature .pv img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.16, 1, .3, 1); }
a.lab-feature:hover .pv img { transform: scale(1.025); }
.lab-feature .body { padding: 32px; display: flex; flex-direction: column; justify-content: center; }
.lab-feature .kicker { font-family: var(--mono); font-size: 10px; letter-spacing: .18em; color: var(--muted); margin-bottom: 10px; }
.lab-feature .nm { font-size: 28px; font-weight: 700; letter-spacing: -.01em; }
[data-theme="blueprint"] .lab-feature .nm { font-family: var(--mono); font-weight: 500; letter-spacing: .02em; }
.lab-feature .ds { font-size: 14px; max-width: 30em; line-height: 1.7; }
.lab-feature .st { display: flex; justify-content: space-between; gap: 12px; padding-top: 18px; margin-top: 18px; border-top: 1px solid var(--soft-line); }
.lab-feature .go { color: var(--fg); }
a.lab-feature:hover .go { color: var(--accent); }
@media (max-width: 760px) {
  .lab-feature { grid-template-columns: 1fr; }
  .lab-feature .pv { min-height: 0; height: 190px; border-right: 0; border-bottom: 1px solid var(--soft-line); }
  .lab-feature .body { padding: 20px; }
  .lab-feature .nm { font-size: 23px; }
}
</style>
