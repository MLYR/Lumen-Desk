---
import LabGrid from "./LabGrid.astro";
---
<section class="grid" id="lab">
  <article class="card first last">
    <div class="card-head">
      <h2 class="card-title"><span class="dot"></span>试验场</h2>
      <a class="card-meta more" href="/lab/">全部实验 →</a>
    </div>
    <LabGrid id="home-labs" />
  </article>
</section>

<script>
  import { homeLabItems, parseLabs, renderLabGrid } from "../lib/lab";

  const box = document.getElementById("home-labs")!;
  const empty = () => { box.innerHTML = renderLabGrid([]); };
  (async () => {
    try {
      const res = await fetch("/api/lab");
      if (!res.ok) throw new Error(String(res.status));
      const items = homeLabItems(parseLabs(await res.json()));
      box.innerHTML = renderLabGrid(items);
    } catch { empty(); }
  })();
</script>
