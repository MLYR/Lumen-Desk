---
// 主页简历卡片：精简版，运行时请求 /api/resume 渲染（最近两段经历 + 技能）。没有旧的占位数据。
---
<section class="grid" id="resume">
  <article class="card first last">
    <div class="card-head">
      <h2 class="card-title"><span class="dot"></span>简历</h2>
      <a class="card-meta more" href="/resume/">查看完整简历 →</a>
    </div>
    <div class="resume" id="home-resume"><p class="resume-empty">加载中…</p></div>
  </article>
</section>

<script>
  import { renderCompact, type PResume } from "../scripts/resume-render";
  const box = document.getElementById("home-resume")!;
  const empty = () => { box.replaceChildren(); const p = document.createElement("p"); p.className = "resume-empty"; p.textContent = "简历整理中"; box.append(p); };
  (async () => {
    try {
      const res = await fetch("/api/resume", { cache: "no-store" });
      if (!res.ok) return empty();
      const r = (await res.json()) as PResume;
      if (!r || !Array.isArray(r.work) || !Array.isArray(r.skills)) return empty();
      if (!r.work.length && !r.skills.length) return empty();
      // 完整信息对外显示时，主页的精简版也会出现公司名：和 /resume/ 一样加 noindex，避免被搜索引擎缓存。
      if (r.reveal === true || r.revealPublic === true) {
        const m = document.createElement("meta"); m.name = "robots"; m.content = "noindex"; document.head.append(m);
      }
      renderCompact(r, box);
    } catch { empty(); }
  })();
</script>

<style is:global>
.resume { display: grid; gap: 28px; }
@media (min-width: 900px) { .resume { grid-template-columns: 1fr 1fr; gap: 48px; } }
.resume h3 { font-family: var(--mono); font-size: 12px; font-weight: 500; color: var(--muted); margin-bottom: 12px; letter-spacing: .04em; }
.resume-empty { color: var(--muted); font-size: 14px; padding: 8px 0; }
.timeline { list-style: none; }
.timeline li { display: grid; grid-template-columns: 112px 1fr; gap: 16px; padding: 12px 0; border-top: 1px solid var(--soft-line); }
.timeline .when { font-family: var(--mono); font-size: 12px; color: var(--muted); padding-top: 3px; }
.timeline .what { font-size: 15px; font-weight: 600; overflow-wrap: anywhere; }
.timeline .desc { font-size: 14px; color: var(--muted); margin-top: 2px; overflow-wrap: anywhere; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.skills { display: grid; gap: 12px; }
.skills div { display: grid; grid-template-columns: 72px 1fr; gap: 12px; align-items: baseline; padding-top: 12px; border-top: 1px solid var(--soft-line); }
.skills dt { font-family: var(--mono); font-size: 12px; color: var(--muted); }
.skills dd { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
@media (max-width: 480px) { .timeline li { grid-template-columns: 1fr; gap: 4px; } }
.rf-lock { display: inline-flex; vertical-align: -1px; margin-left: 4px; color: var(--muted); opacity: .8; }
</style>
