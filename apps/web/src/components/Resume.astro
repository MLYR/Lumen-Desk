---
// 主页简历卡片：精简版，运行时请求 /api/resume 渲染（左技能、右经历与项目简述）。没有旧的占位数据。
---
<section class="grid" id="resume">
  <article class="card first last">
    <div class="card-head">
      <h2 class="card-title"><span class="dot"></span>简历</h2>
      <a class="card-meta more" href="/resume/">查看完整简历 →</a>
    </div>
    <div class="resume" id="home-resume"><p class="resume-empty">加载中…</p></div>
  </article>
</section>

<script>
  import { renderCompact, type PResume } from "../scripts/resume-render";
  const box = document.getElementById("home-resume")!;
  const empty = () => { box.replaceChildren(); const p = document.createElement("p"); p.className = "resume-empty"; p.textContent = "简历整理中"; box.append(p); };
  (async () => {
    try {
      const res = await fetch("/api/resume", { cache: "no-store" });
      if (!res.ok) return empty();
      const r = (await res.json()) as PResume;
      if (!r || !Array.isArray(r.work) || !Array.isArray(r.skills)) return empty();
      const projects = Array.isArray(r.projects) ? r.projects : [];
      if (!r.work.length && !r.skills.length && !projects.length) return empty();
      // 完整信息对外显示时，主页的精简版也会出现公司名与项目名：和 /resume/ 一样加 noindex，避免被搜索引擎缓存。
      if (r.reveal === true || r.revealPublic === true) {
        const m = document.createElement("meta"); m.name = "robots"; m.content = "noindex"; document.head.append(m);
      }
      renderCompact(r, box);
    } catch { empty(); }
  })();
</script>

<style is:global>
.resume { display: grid; gap: 28px; align-items: start; }
@media (min-width: 900px) { .resume { grid-template-columns: 1fr 1fr; gap: 48px; } }
.resume.is-single { grid-template-columns: 1fr; }
.resume-col { min-width: 0; }
.resume-exp { display: grid; gap: 24px; align-content: start; }
.resume-block { min-width: 0; }
.resume h3 { font-family: var(--mono); font-size: 12px; font-weight: 500; color: var(--muted); margin-bottom: 12px; letter-spacing: .04em; }
.resume-empty { color: var(--muted); font-size: 14px; padding: 8px 0; }
.timeline { list-style: none; }
.timeline li { display: grid; grid-template-columns: 112px 1fr; gap: 16px; padding: 12px 0; border-top: 1px solid var(--soft-line); }
.timeline li:last-child { padding-bottom: 0; }
.timeline .when { font-family: var(--mono); font-size: 12px; color: var(--muted); padding-top: 3px; }
.timeline .what { font-size: 15px; font-weight: 600; overflow-wrap: anywhere; }
.timeline .desc, .proj-list .desc { font-size: 14px; color: var(--muted); margin-top: 4px; overflow-wrap: anywhere; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.proj-list { list-style: none; }
.proj-list li { padding: 12px 0; border-top: 1px solid var(--soft-line); }
.proj-list li:last-child { padding-bottom: 0; }
.proj-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; min-width: 0; }
.proj-name { font-size: 15px; font-weight: 600; overflow-wrap: anywhere; min-width: 0; }
.proj-sep, .proj-client { font-size: 13px; font-weight: 400; color: var(--muted); }
.proj-meta { font-family: var(--mono); font-size: 12px; color: var(--muted); overflow-wrap: anywhere; }
.skills { display: grid; gap: 12px; }
.skills div { display: grid; grid-template-columns: 98px 1fr; gap: 14px; align-items: baseline; padding-top: 12px; border-top: 1px solid var(--soft-line); }
.skills dt { font-family: var(--mono); font-size: 12px; color: var(--muted); }
.skills dd { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
.skills .chip { overflow-wrap: anywhere; max-width: 100%; }
@media (max-width: 480px) {
  .timeline li { grid-template-columns: 1fr; gap: 4px; }
  .skills div { grid-template-columns: 1fr; gap: 6px; }
}
.rf-lock { display: inline-flex; vertical-align: -1px; margin-left: 4px; color: var(--muted); opacity: .8; }
</style>
