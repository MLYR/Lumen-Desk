---
import Layout from "../layouts/Layout.astro";
import ConsoleTop from "../components/ConsoleTop.astro";
import "../styles/console.css";
import "../styles/ui.css";
import "../styles/bookmarks.css";
---
<Layout title="控制台 · 拾光台" noindex>
<ConsoleTop current="home">
  <button slot="tools" class="btn" id="openPalette" aria-label="打开命令面板">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <span class="lbl">跳转</span><kbd>⌘K</kbd>
  </button>
</ConsoleTop>

<main class="wrap">
  <section class="hero">
    <div>
      <div class="coord">// SHANGHAI · 31.23°N 121.47°E</div>
      <div class="greet" id="greet">你好</div>
      <div class="clock" id="clock">--:--<span class="sec">--</span></div>
      <div class="date" id="date"></div>
    </div>
    <form class="search" id="searchForm" role="search">
      <div class="coord" style="margin-bottom:0">// QUERY</div>
      <div class="engines" id="engines"></div>
      <label class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--muted)"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input id="q" type="search" placeholder="搜索，或按 / 聚焦" autocomplete="off" aria-label="搜索">
        <kbd>/</kbd>
      </label>
    </form>
  </section>

  <section class="grid">
    <article class="card span-7 first">
      <div class="card-head">
        <h2 class="card-title"><a class="card-link" href="/" target="_blank" rel="noopener" title="在新标签页打开公开主页"><span class="dot"></span>个人简介<svg class="ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a></h2>
        <span class="card-meta">公开主页同步展示</span>
      </div>
      <div class="profile">
        <div class="avatar" aria-hidden="true"><img id="pf-avatar" alt="" hidden><span id="pf-initial">z</span></div>
        <div class="who">
          <h2 id="pf-name">zreo</h2>
          <div class="role">程序员 · 喜欢研究新技术和新软件</div>
        </div>
        <p class="bio" id="pf-bio">这里是我的私人控制台。公开主页上有我的简历、博客和技术试验场。</p>
        <dl class="spec">
          <div><dt>栈</dt><dd>Java · Vue · React（待确认）</dd></div>
          <div><dt>在研究</dt><dd>Astro · Hono · AI Agent</dd></div>
          <div><dt>坐标</dt><dd>上海</dd></div>
          <div><dt>站点</dt><dd>腾讯云轻量 · 4C4G3M</dd></div>
        </dl>
        <div class="pub-links">
          <a href="/">公开主页</a>
          <a href="https://github.com" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </article>
    <article class="card span-5 last">
      <div class="card-head">
        <h2 class="card-title"><span class="dot"></span>AI 热点</h2>
        <span class="card-meta"><span class="live">TOP 10</span> · 来源 <a href="https://aihot.news/hot" target="_blank" rel="noopener">AIHOT</a></span>
      </div>
      <div class="ticker" id="ticker"><ul class="ticker-track" id="tickerTrack"></ul></div>
    </article>
  </section>

  <section class="grid">
    <article class="card first last" id="bmCard">
      <div class="card-head">
        <h2 class="card-title"><span class="dot"></span>收藏夹</h2>
        <span class="card-meta" id="bmCount"></span>
        <span class="bm-tools">
          <button class="bm-switch" id="bmEditSwitch" type="button" role="switch" aria-pressed="false" aria-label="编辑模式"><span class="bm-switch-t">编辑</span></button>
          <button class="bm-manage" id="bmManage" type="button" aria-label="管理收藏夹">管理 ▾</button>
          <input id="bmImportFile" type="file" accept=".html,.htm,text/html" hidden>
        </span>
      </div>
      <div class="bm">
        <div class="bm-side">
          <label class="bm-filter">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--muted)"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
            <input id="bmq" placeholder="筛选全部书签" autocomplete="off" aria-label="筛选书签">
          </label>
          <ul class="folders scroll" id="folders"></ul>
        </div>
        <div class="bm-main">
          <div class="bm-scroll scroll" id="bmMain"><div class="bm-empty">加载中…</div></div>
          <div class="bm-fade"></div>
        </div>
      </div>
    </article>
  </section>

  <section class="grid">
        <article class="card span-6 first" id="rsCard">
      <div class="card-head">
        <h2 class="card-title"><a class="card-link" href="/resume/" target="_blank" rel="noopener" title="在新标签页打开公开简历"><span class="dot"></span>简历<svg class="ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a></h2>
        <a class="card-meta more" href="/console/resume">编辑简历</a>
      </div>
      <div class="rs" id="rsBody">
        <div class="rs-state"><span class="rs-badge" id="rsBadge">—</span><span class="rs-note" id="rsNote">加载中…</span></div>
        <dl class="rs-stats">
          <div><dt>工作经历</dt><dd id="rsWork">—</dd></div>
          <div><dt>项目</dt><dd id="rsProj">—</dd></div>
          <div><dt>技能分组</dt><dd id="rsSkill">—</dd></div>
          <div><dt>打码字段</dt><dd id="rsMasked">—</dd></div>
        </dl>
        <div class="rs-recent"><p class="rs-h">最近经历</p><ul id="rsRecent"><li class="rs-empty">—</li></ul></div>
        <div class="svc"><span>最近更新</span><span class="val" id="rsUpdated">—</span></div>
        <a class="rs-public" href="/resume/" target="_blank" rel="noopener">查看公开简历 →</a>
      </div>
    </article>
    <article class="card span-6 last" id="srvCard">
      <div class="card-head">
        <h2 class="card-title"><span class="dot"></span>服务器</h2>
        <span class="srv-tag" id="srvTag" hidden></span>
      </div>
      <p class="srv-line" id="srvLine">—</p>
      <div class="stats srv-stats">
        <div class="stat" id="stCpu"><div class="v">—</div><div class="k">CPU</div><div class="bar"><i style="width:0"></i></div></div>
        <div class="stat" id="stMem"><div class="v">—</div><div class="k">内存</div><div class="bar"><i style="width:0"></i></div></div>
        <div class="stat" id="stDisk"><div class="v">—</div><div class="k">磁盘</div><div class="bar"><i style="width:0"></i></div></div>
        <div class="stat" id="stSwap"><div class="v">—</div><div class="k">交换</div><div class="bar"><i style="width:0"></i></div></div>
      </div>
      <div class="srv-net" id="srvNet"><span class="net-rate" id="srvRate">—</span><span class="net-total" id="srvTotal"></span></div>
      <div class="services">
        <div class="svc"><span>负载 1 / 5 / 15 分钟</span><span class="val" id="svLoad">—</span></div>
        <div class="svc"><span>主机已运行</span><span class="val" id="svHost">—</span></div>
        <div class="svc"><span>API 已运行</span><span class="val" id="svUp">—</span></div>
      </div>
      <ul class="srv-svcs" id="srvSvcs" aria-label="服务状态"></ul>
    </article>
    <article class="card span-6 first">
      <div class="card-head">
        <h2 class="card-title"><a class="card-link" href="/blog/" target="_blank" rel="noopener" title="在新标签页打开博客"><span class="dot"></span>博客<svg class="ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a></h2>
        <a class="card-meta more" href="/console/write">写文章</a>
      </div>
      <ul class="posts">
        <li><span class="t">用一台 3M 小水管服务器搭个人站</span><span class="d">草稿</span></li>
        <li><span class="t">接入 AIHOT：ETag 与条件请求</span><span class="d">草稿</span></li>
        <li><span class="t">Astro 岛屿架构上手记录</span><span class="d">草稿</span></li>
      </ul>
    </article>
    <article class="card span-6 last">
      <div class="card-head">
        <h2 class="card-title"><a class="card-link" href="/#lab" target="_blank" rel="noopener" title="在新标签页打开试验场"><span class="dot"></span>试验场<svg class="ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg></a></h2>
        <a class="card-meta more" href="/#lab">全部实验</a>
      </div>
      <canvas class="lab-canvas" id="lab-canvas" aria-label="流场粒子演示"></canvas>
      <div class="lab-list"><span class="chip">Canvas 流场</span><span class="chip">WebGPU</span><span class="chip">Three.js</span><span class="chip">WASM</span></div>
    </article>
  </section>
</main>

<footer>
  <div class="wrap">
    <span>私人控制台 · 不被搜索引擎收录 · AI 资讯来源 <a href="https://aihot.news" target="_blank" rel="noopener">AIHOT</a></span>
    <a href="/">返回公开主页</a>
  </div>
</footer>

<div class="palette" id="palette" role="dialog" aria-modal="true" aria-label="命令面板">
  <div class="palette-box">
    <div class="palette-input">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--muted)"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="pq" placeholder="搜书签或命令，如 github、蓝图" autocomplete="off" aria-label="命令搜索">
      <kbd>Esc</kbd>
    </div>
    <ul class="palette-list" id="plist" role="listbox"></ul>
  </div>
</div>

<script>
  import "../scripts/console/main";
</script>
</Layout>
