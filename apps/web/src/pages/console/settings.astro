---
// 设置页 /console/settings：个人资料、分类和标签、账号安全。
// 构建后由 scripts/split-private.mjs 移到 dist-private/console/settings/。不传 analytics，不插 Umami。
import Layout from "../../layouts/Layout.astro";
import ConsoleTop from "../../components/ConsoleTop.astro";
import "../../styles/console.css";
import "../../styles/intro.css";
import "../../styles/ui.css";
import "../../styles/settings.css";
---
<Layout title="设置 · 拾光台" noindex>
<ConsoleTop current="settings" />

<main class="wrap st">
  <nav class="st-nav" role="tablist" aria-label="设置分区" aria-orientation="vertical">
    <button type="button" role="tab" id="tab-profile" data-s="profile" aria-controls="sec-profile" aria-selected="true">个人资料</button>
    <button type="button" role="tab" id="tab-taxonomy" data-s="taxonomy" aria-controls="sec-taxonomy" aria-selected="false" tabindex="-1">分类和标签</button>
    <button type="button" role="tab" id="tab-backup" data-s="backup" aria-controls="sec-backup" aria-selected="false" tabindex="-1">数据备份</button>
    <button type="button" role="tab" id="tab-security" data-s="security" aria-controls="sec-security" aria-selected="false" tabindex="-1">账号安全</button>
  </nav>

  <div class="st-body">
    <div class="st-msg" id="st-msg" role="status" aria-live="polite"></div>

    <!-- 个人资料 -->
    <section class="st-sec" id="sec-profile" role="tabpanel" aria-labelledby="tab-profile">
      <div class="pf-grid">
        <form class="pf-form" id="pf-form" autocomplete="off" novalidate>
          <h1 class="st-h">个人资料</h1>
          <p class="st-sub">同步到公开主页的简介、控制台的简介卡和右上角头像。</p>
          <div class="pf-avatar-row">
            <span class="pf-avatar" id="pfa"><img id="pfa-img" alt="" hidden><span id="pfa-ini">Z</span></span>
            <div class="pf-avatar-btns">
              <button class="btn" type="button" id="avatar-upload">上传头像</button>
              <button class="btn" type="button" id="avatar-remove" hidden>移除头像</button>
              <input type="file" id="avatar-file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" hidden>
              <span class="st-hint">会裁成正方形，不超过 10 MB</span>
            </div>
          </div>
          <label class="fld"><span>名字</span><input id="pf-name" maxlength="40" required></label>
          <label class="fld"><span>一句话介绍（主页大标题下面那段）</span><textarea id="pf-tagline" rows="2" maxlength="80"></textarea></label>
          <label class="fld"><span>简介（控制台简介卡）</span><textarea id="pf-bio" rows="3" maxlength="500"></textarea></label>

          <fieldset class="pf-list"><legend>主页右侧信息（最多 6 条）</legend>
            <ul id="facts-list"></ul>
            <button class="btn" type="button" id="fact-add">添加一条</button>
          </fieldset>
          <fieldset class="pf-list"><legend>链接（最多 6 条，只支持 http、https、mailto）</legend>
            <ul id="links-list"></ul>
            <button class="btn" type="button" id="link-add">添加一条</button>
          </fieldset>
          <div class="st-actions"><button class="btn primary" type="submit" id="pf-save">保存资料</button></div>
        </form>

        <aside class="pf-preview" aria-label="主页简介预览">
          <div class="pv-head">主页预览</div>
          <section class="intro pv-intro">
            <div>
              <div class="coord">// HELLO WORLD</div>
              <h1>写代码，<br>也喜欢研究<em>新东西</em>。</h1>
              <p id="pv-tagline"></p>
              <div class="cta" id="pv-links"></div>
            </div>
            <dl class="intro-side" id="pv-facts"></dl>
          </section>
        </aside>
      </div>
    </section>

    <!-- 分类和标签 -->
    <section class="st-sec" id="sec-taxonomy" role="tabpanel" aria-labelledby="tab-taxonomy" hidden>
      <h1 class="st-h">分类和标签</h1>
      <p class="st-sub">分类用英文 slug 做网址，一篇文章只属于一个分类；标签网址保持中文。</p>
      <div class="tx-grid">
        <div class="tx-col">
          <h2 class="st-h2">分类</h2>
          <ul class="tx-list" id="cat-list"></ul>
          <form class="tx-add" id="cat-add" autocomplete="off">
            <input id="cat-name" maxlength="20" placeholder="新分类名称" aria-label="新分类名称">
            <input id="cat-slug" maxlength="40" placeholder="slug（可选）" aria-label="新分类 slug" spellcheck="false">
            <button class="btn" type="submit">添加</button>
          </form>
        </div>
        <div class="tx-col">
          <h2 class="st-h2">标签</h2>
          <ul class="tx-list" id="tag-list"></ul>
          <form class="tx-add" id="tag-add" autocomplete="off">
            <input id="tag-name" maxlength="30" placeholder="新标签" aria-label="新标签">
            <button class="btn" type="submit">添加</button>
          </form>
        </div>
      </div>
    </section>

    <!-- 数据备份 -->
    <section class="st-sec" id="sec-backup" role="tabpanel" aria-labelledby="tab-backup" hidden>
      <h1 class="st-h">数据备份</h1>
      <p class="st-sub">把文章、简历、书签、分类和标签、个人资料以及上传的图片打包成一个 ZIP。换服务器时，在新站点的控制台导入同一个文件即可。</p>
      <div class="bk-grid">
        <div class="bk-card">
          <h2 class="st-h2">导出</h2>
          <p class="st-sub">包含全部动态内容，不包含验证器、恢复码和登录状态。</p>
          <div class="st-actions"><button class="btn primary" type="button" id="bk-download">下载全部数据 (.zip)</button></div>
          <p class="st-hint" id="bk-export-state">内容越多，打包需要的时间越长。</p>
        </div>
        <div class="bk-card">
          <h2 class="st-h2">导入</h2>
          <p class="st-sub">用备份替换当前站点的全部动态内容。验证器、恢复码和登录状态不会被改动。</p>
          <input type="file" id="bk-file" accept=".zip,application/zip" hidden>
          <div class="st-actions">
            <button class="btn" type="button" id="bk-pick">选择备份 .zip</button>
            <button class="btn danger" type="button" id="bk-import" disabled>导入并覆盖</button>
          </div>
          <p class="st-hint" id="bk-file-name">未选择文件</p>
          <p class="st-hint">最大 40 MB。导入完成后页面会刷新。</p>
        </div>
      </div>
      <p class="bk-note">备份是站点内容，不是数据库文件，包含简历原文和个人资料。文件没有加密，请只放在自己信任的地方。导入前建议先下载一次当前数据，留一份可回退的副本。</p>
    </section>

    <!-- 账号安全 -->
    <section class="st-sec" id="sec-security" role="tabpanel" aria-labelledby="tab-security" hidden>
      <h1 class="st-h">账号安全</h1>
      <dl class="sc-stats">
        <div><dt>剩余恢复码</dt><dd id="sc-codes">—</dd></div>
        <div><dt>已登录设备</dt><dd id="sc-sessions">—</dd></div>
        <div><dt>本设备登录于</dt><dd id="sc-since">—</dd></div>
      </dl>
      <p class="sc-warn" id="sc-warn" hidden>恢复码只剩不到 3 个了，建议重新生成。</p>

      <h2 class="st-h2">退出设备</h2>
      <div class="st-actions">
        <button class="btn" type="button" id="revoke-others">退出其他设备</button>
        <button class="btn danger" type="button" id="revoke-all">退出所有设备</button>
      </div>

      <h2 class="st-h2">验证器</h2>
      <p class="st-sub">换了手机或想更换验证器时，重新绑定。需要先输入当前验证器上的 6 位码；新验证器确认之前，旧的一直有效。</p>
      <div class="st-actions"><button class="btn" type="button" id="rebind-btn">重新绑定验证器</button></div>

      <h2 class="st-h2">重新生成恢复码</h2>
      <p class="st-sub">旧恢复码会全部作废。新的恢复码只显示一次，请立刻保存。</p>
      <form class="sc-regen" id="regen-form" autocomplete="off">
        <label class="fld"><span>当前的 6 位验证码</span><input id="regen-code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" placeholder="000000"></label>
        <button class="btn primary" type="submit" id="regen-btn">重新生成</button>
      </form>
      <div class="sc-codes" id="sc-codes-box" hidden>
        <div class="sc-codes-head">新的恢复码（只显示这一次）</div>
        <ul id="sc-codes-list"></ul>
        <div class="st-actions">
          <button class="btn" type="button" id="codes-copy">复制</button>
          <button class="btn" type="button" id="codes-download">下载 .txt</button>
        </div>
      </div>
    </section>
  </div>
</main>

<footer>
  <div class="wrap">
    <span>设置 · 仅自己可见</span>
    <a href="/console">返回控制台</a>
  </div>
</footer>

<script>
  import "../../scripts/console/settings";
</script>
</Layout>
