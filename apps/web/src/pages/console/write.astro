---
// 私有编辑器 /console/write。构建后由 scripts/split-private.mjs 移到 dist-private/console/write/。
// 不传 analytics：控制台永远不插统计脚本。
import Layout from "../../layouts/Layout.astro";
import ConsoleTop from "../../components/ConsoleTop.astro";
import "../../styles/console.css";
import "../../styles/blog.css";
import "../../styles/write.css";
---
<Layout title="写文章 · 拾光台" noindex>
<ConsoleTop current="write" wide />

<main class="wrap wide ed" id="ed" data-tab="edit">
  <div class="ed-toolbar" role="toolbar" aria-label="文章操作">
    <div class="ed-tb-left">
      <button class="btn" id="import-btn" type="button" title="选择一个 .md 文件填进编辑器，也可以把文件拖进页面">导入 .md</button>
      <select class="ed-open" id="open-select" aria-label="打开已有文章"><option value="">打开已有文章…</option></select>
      <button class="btn" id="new-post" type="button">新文章</button>
      <a class="btn" id="export-link" href="/api/private/posts/export" download>导出全部</a>
      <input id="import-file" type="file" accept=".md,.markdown,text/markdown" multiple hidden>
    </div>
    <div class="ed-tb-right">
      <span class="ed-state" id="ed-state">新文章</span>
      <button class="btn danger" id="delete-btn" type="button" hidden>删除</button>
      <button class="btn primary" id="save-btn" type="button"><span id="save-label">发布</span> <kbd>⌘S</kbd></button>
    </div>
  </div>
  <div class="ed-msg" id="ed-msg" role="status" aria-live="polite"></div>

  <div class="ed-tabs" role="tablist" aria-label="编辑与预览">
    <button type="button" role="tab" id="tab-edit" data-t="edit" aria-selected="true" aria-controls="pane-edit">编辑</button>
    <button type="button" role="tab" id="tab-preview" data-t="preview" aria-selected="false" aria-controls="pane-preview">预览</button>
  </div>

  <form class="ed-pane ed-form" id="pane-edit" role="tabpanel" aria-labelledby="tab-edit" autocomplete="off" novalidate>
    <label class="fld"><span>标题</span><input id="f-title" maxlength="200" placeholder="文章标题" required></label>
    <div class="fld-row">
      <label class="fld"><span>slug</span><input id="f-slug" maxlength="80" placeholder="留空自动生成" spellcheck="false" autocapitalize="off"></label>
      <label class="fld"><span>状态</span>
        <select id="f-status"><option value="published">发布</option><option value="draft">草稿</option></select>
      </label>
      <label class="fld"><span>发布时间</span><input id="f-published" type="datetime-local"></label>
    </div>
    <div class="fld-row fld-row2">
      <label class="fld"><span>分类</span>
        <select id="f-category"><option value="">未分类</option><option value="__new">+ 新分类…</option></select>
      </label>
      <div class="fld fld-tags">
        <span id="tags-label">标签（回车或逗号添加）</span>
        <div class="tagbox" id="tagbox">
          <span id="tag-chips" class="tag-chips"></span>
          <input id="f-tags" role="combobox" aria-labelledby="tags-label" aria-autocomplete="list" aria-expanded="false" aria-controls="tag-suggest" placeholder="输入标签" maxlength="60" autocomplete="off">
        </div>
        <ul class="tag-suggest" id="tag-suggest" role="listbox" hidden></ul>
      </div>
    </div>
    <div class="fld newcat" id="newcat-row" hidden>
      <span>新分类名称（保存时自动创建）</span>
      <div class="newcat-line"><input id="f-newcat" maxlength="20" placeholder="1–20 个字"><button class="btn" id="newcat-cancel" type="button">取消</button></div>
    </div>
    <label class="fld"><span>摘要（留空取正文开头）</span><textarea id="f-summary" rows="2" maxlength="500"></textarea></label>
    <label class="fld grow"><span>正文（Markdown）</span><textarea id="f-md" spellcheck="false" placeholder="在这里写 Markdown。粘贴或拖入图片会自动上传。"></textarea></label>
  </form>

  <section class="ed-pane ed-preview" id="pane-preview" role="tabpanel" aria-labelledby="tab-preview">
    <div class="ed-preview-head"><span>预览</span><span id="pv-state"></span></div>
    <div class="prose" id="preview"><p class="ed-note">预览会显示在这里。</p></div>
  </section>
</main>

<div class="drop" id="drop" hidden><div>松开以打开 .md 文件<small>图片请拖进正文文本框</small></div></div>

<script>
  import "../../scripts/console/write";
</script>
</Layout>
