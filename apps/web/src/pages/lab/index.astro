---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import LabGrid from "../../components/LabGrid.astro";
import { featuredOf, labItems } from "../../lib/lab";
import "../../styles/lab.css";

const items = await labItems();
const featured = featuredOf(items);
---
<Layout
  title="试验场 · 拾光台"
  description="zreo 的技术试验场：Three.js、程序化着色器、Canvas 与浏览器图形实验。"
  analytics
>
  <Header current="lab" />
  <main class="wrap lb-main">
    <header class="lb-hero">
      <div class="lb-copy">
        <p class="lb-eyebrow"><span class="lb-mark"></span>TECH LAB / 试验场</p>
        <h1>试验场</h1>
        <p class="lb-lead">把想法做成能跑的东西。Three.js、程序化着色器，以及一些还没成形的实验。每个实验一个页面，做出来再放上来。</p>
      </div>
      <dl class="lb-stats">
        <div><dt>当前实验</dt><dd>{featured?.name ?? "还在做"}</dd></div>
        <div><dt>技术栈</dt><dd>{featured?.kicker ?? "—"}</dd></div>
        <div><dt>实验数</dt><dd>{items.length} 个</dd></div>
      </dl>
    </header>

    <div class="lb-grid">
      <LabGrid items={items} />
    </div>
  </main>
  <Footer />
</Layout>
