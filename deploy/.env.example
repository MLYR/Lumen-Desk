# 复制为 .env 后再填写。.env 只放在服务器上，不进 Git。

# Caddy 站点地址。ICP 备案前保持 :80（用 IP 访问）；备案后改成域名，例如 your.domain，Caddy 会自动申请 HTTPS。
SITE_ADDRESS=:80

# 加密数据库里 TOTP 密钥的主密钥（AES-256-GCM），32 字节 base64。生成：openssl rand -base64 32
# 只放在服务器 .env 里，不进仓库；丢了它，数据库里的 TOTP 密钥就解不开，要重新 init-totp。
SECRET_KEY=

# 旧版的 TOTP 密钥。现在 init-totp 直接把密钥写进数据库，这里留空即可。
# 只在数据库里还没有密钥时才会用它（兼容旧部署）；数据库里有密钥后它会被忽略。
TOTP_SECRET=
# Google Authenticator 里显示的发行方和账号名。
TOTP_ISSUER=Lumen Desk
TOTP_LABEL=zreo

# Cookie 的 Secure 标记。只有 HTTPS 域名上线后才能设为 true，否则浏览器不会回传 Cookie。
COOKIE_SECURE=false

# 运行在 Caddy 后面时设为 true，使用 X-Forwarded-For 取得客户端 IP（限流用）。
TRUST_PROXY=true

# 站点的完整地址，例如 https://your.domain，用于生成链接。
SITE_URL=

# 服务内部配置，一般不用改。
DATA_DIR=/data
PORT=3000

# 博客页面外壳目录（apps/web 的 dist-shell，CI 同步到服务器的 web/shell，挂进 api 容器）。
# docker-compose.yml 已经写死这个值，这里只是留个记录，一般不用改。
SHELL_DIR=/srv/shell

# 控制台「服务器」卡片读取宿主机信息的目录（三个只读挂载，见 deploy/README.md「服务器状态」）。
# docker-compose.yml 已经写死这个值，这里只是留个记录，一般不用改。
HOST_ROOT=/host

# ---- 访问统计 Umami 和状态监控 Uptime Kuma ----

# Umami 的 Caddy 站点地址。备案前保持 :8081（用 http://服务器IP:8081 访问）；备案后改成 stats.你的域名。
STATS_ADDRESS=:8081
# Uptime Kuma 的 Caddy 站点地址。备案前保持 :8082；备案后改成 status.你的域名。
STATUS_ADDRESS=:8082

# 管理后台（8081 Umami、8082 Uptime Kuma）的 basic_auth 账号。必填，没填 docker compose 会报错。
# 访客打开后台先要过这一道，再到 Umami 或 Kuma 自己的登录页。
ADMIN_USER=admin
# bcrypt 哈希，不是明文密码。生成：
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '你的密码'
# 哈希里有 $，必须用单引号整个包起来，否则 docker compose 会把 $ 当成变量。例如：
#   ADMIN_PASSWORD_HASH='$2a$14$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
ADMIN_PASSWORD_HASH=

# Umami 的数据库密码和签名密钥不在这个文件里，见 deploy/umami.env.example（复制成 umami.env）。

# 可选：换 Umami 或 Uptime Kuma 的镜像。默认值写在 docker-compose.yml 里，
# 国内服务器拉不动时可以换成 ghcr 源，例如 ghcr.io/umami-software/umami:3.4.1。
# UMAMI_IMAGE=
# KUMA_IMAGE=
