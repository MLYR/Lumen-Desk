{
	admin off
}

# SITE_ADDRESS 默认 :80（ICP 备案前用 IP 访问）；备案后改成域名即自动 HTTPS。
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		# P1.5-5：script-src 暂时放行 'unsafe-inline'（Astro 内联主题脚本）。
		# 后续把内联脚本算成 sha256 hash，再把 'unsafe-inline' 去掉。
		# Umami 的统计脚本和上报走本站 /u/*（同源），所以不需要放行外部域名。
		# img-src 放行 https:，文章里可以引用外部图片，省服务器带宽。
		# 前面的 ? 表示"没设置过才设"：/uploads/* 会自己设一个更严的 CSP，不能被这里覆盖。
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}

	# 私有接口：未登录一律 401，不做跳转。
	handle /api/private/* {
		forward_auth api:3000 {
			uri /api/auth/check
			@unauth status 401
			handle_response @unauth {
				respond 401
			}
		}
		# 和 api 自身的上限对齐（都按 MiB）：图片和头像上传 12 MiB，批量导入 .md（最多 20 个 × 1 MiB）21 MiB，
		# 导入浏览器书签文件（≤ 5 MiB，加上 multipart 开销）6 MiB，其他私有接口 3 MiB（单篇正文 1 MiB，JSON 转义后会变大）。
		@upload path /api/private/uploads /api/private/profile/avatar
		request_body @upload {
			max_size 12MiB
		}
		@import path /api/private/posts/import
		request_body @import {
			max_size 21MiB
		}
		@bmimport path /api/private/bookmarks/import
		request_body @bmimport {
			max_size 6MiB
		}
		@otherprivate not path /api/private/uploads /api/private/profile/avatar /api/private/posts/import /api/private/bookmarks/import
		request_body @otherprivate {
			max_size 3MiB
		}
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# 私人控制台：未登录跳转登录页。私有静态文件在 /srv/private。
	@console path /console /console/*
	handle @console {
		forward_auth api:3000 {
			uri /api/auth/check
			@unauth status 401
			handle_response @unauth {
				redir * /login 302
			}
		}
		root * /srv/private
		header X-Robots-Tag noindex
		header Cache-Control no-store
		try_files {path} {path}/index.html
		file_server
	}

	# 登录页：公开可访问，但不收录。
	handle /login* {
		header X-Robots-Tag noindex
		root * /srv/public
		try_files {path} {path}/ {path}/index.html
		file_server
	}

	# 博客页面、RSS、站点地图由 api 渲染。覆盖客户端自带的 X-Forwarded-For。
	@blog path /blog /blog/* /rss.xml /sitemap.xml
	handle @blog {
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# 上传的图片：文件名是内容哈希，可以长期缓存。
	# CSP default-src 'none' 让浏览器直接打开图片 URL 时也不会执行任何内容。
	handle /uploads/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		header Content-Security-Policy "default-src 'none'"
		file_server
	}

	# Umami 统计脚本和上报接口，走主站同源，访客浏览器不用连 8081。
	# 只放行两个路径：脚本（GET）和上报（POST）。Umami 的后台页面和其他接口一律 404，
	# 想看后台要走 STATS_ADDRESS（有 basic_auth）。
	# 脚本会用自己所在目录作为上报地址，所以 /u/script.js 会往 /u/api/send 发数据。
	handle_path /u/* {
		@script {
			method GET HEAD
			path /script.js
		}
		@send {
			method POST
			path /api/send
		}
		handle @script {
			reverse_proxy umami:3000 {
				header_up -Cookie
				header_up X-Forwarded-For {remote_host}
			}
		}
		handle @send {
			request_body {
				max_size 64KiB
			}
			reverse_proxy umami:3000 {
				header_up -Cookie
				header_up X-Forwarded-For {remote_host}
			}
		}
		handle {
			respond 404
		}
	}

	# 公开接口（AIHOT 缓存等）。覆盖客户端自带的 X-Forwarded-For。
	handle /api/* {
		request_body {
			max_size 1MiB
		}
		reverse_proxy api:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# 其余全部是公开静态页。
	handle {
		root * /srv/public
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} {path}/ {path}/index.html
		file_server
	}

	# 404 时返回 /404.html（若存在）。
	handle_errors {
		@notfound expression {http.error.status_code} == 404
		handle @notfound {
			root * /srv/public
			rewrite * /404.html
			file_server
		}
	}
}

# Umami 后台。备案前用 :8081（IP 访问），备案后改成 stats.域名。
# 先过 basic_auth（账号和 bcrypt 哈希在 .env 的 ADMIN_USER、ADMIN_PASSWORD_HASH），再到 Umami 自己的登录页。
# 不加 CSP：Umami 自己的后台页面需要内联脚本。
# header_up -Cookie：不把主站的登录 Cookie（ld_session）转发给后台。
{$STATS_ADDRESS::8081} {
	encode zstd gzip
	# Umami 网页登录后，调 /api/* 时浏览器脚本会自己带 Authorization: Bearer，盖掉缓存的 basic 凭据，
	# 整站 basic_auth 会让后台页面登录后全部 401（已实测）。所以"/api/* 且带 Bearer"的请求交给 Umami 验证 token。
	# 登录接口 /api/auth/login 不在放行范围内，必须先过 basic_auth，否则带一个假 Bearer 头就能绕过门去试默认账号。
	# 页面和登录接口先过 basic_auth，才能拿到 token。
	@gate {
		not {
			path /api/*
			not path /api/auth/login*
			header Authorization Bearer*
		}
	}
	basic_auth @gate {
		{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
	}
	reverse_proxy umami:3000 {
		header_up -Cookie
	}
}

# Uptime Kuma 后台。备案前用 :8082，备案后改成 status.域名。
# 先过 basic_auth，再到 Kuma 自己的登录页（第一个访问的人会成为管理员，所以这道门必须在）。
# reverse_proxy 自带 WebSocket 支持。不加 CSP。
{$STATUS_ADDRESS::8082} {
	encode zstd gzip
	basic_auth {
		{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
	}
	reverse_proxy uptime-kuma:3001 {
		header_up -Cookie
	}
}
