# 复制为 umami.env 后再填写。只放在服务器上，不进 Git；只有 umami 和 umami-db 两个容器读取，api 读不到。
# 变量名是容器要求的，不要改。

# Postgres 的密码。生成：openssl rand -hex 16
POSTGRES_PASSWORD=

# Umami 连数据库的地址。把 CHANGE_ME 换成上面的 POSTGRES_PASSWORD（两处必须一致）。
# openssl rand -hex 生成的密码只有 0-9a-f，可以直接放进 URL。
DATABASE_URL=postgresql://umami:CHANGE_ME@umami-db:5432/umami

# Umami 的会话签名密钥。生成：openssl rand -hex 32
APP_SECRET=
